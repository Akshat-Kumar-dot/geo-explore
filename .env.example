# Server-side only. Never prefix the key with VITE_ - that would ship it to the browser.
# Copy this file to .env and fill in your own key. .env is git-ignored.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=8787

# Client. "mock" runs on the bundled generators, "api" switches to a real backend.
VITE_DATA_SOURCE=mock
